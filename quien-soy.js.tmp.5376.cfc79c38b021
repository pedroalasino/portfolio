/* ============================================================
   QUIÉN SOY — animación secuencial de entrada
   Encabezado 01 -> sus cards una por una -> recién terminado
   eso, encabezado 02 -> sus cards -> encabezado 03 -> sus cards.
   ============================================================ */
(function () {
  var ANIM_DURATION = 300;
  var CARD_STAGGER = 120;

  function init() {
    var root = document.getElementById('quien-soy-columns');
    if (!root) return;

    var cols = Array.prototype.slice.call(root.querySelectorAll('[data-col]'));
    if (!cols.length) return;

    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) {
      root.querySelectorAll('[data-reveal]').forEach(function (el) {
        el.classList.add('is-visible');
      });
      return;
    }

    function runSequence() {
      var t = 0;
      cols.forEach(function (col) {
        var head = col.querySelector('.quien-soy__head');
        var cards = Array.prototype.slice.call(col.querySelectorAll('.quien-soy__card'));

        (function (el, delay) {
          setTimeout(function () { el.classList.add('is-visible'); }, delay);
        })(head, t);
        t += ANIM_DURATION;

        cards.forEach(function (card) {
          (function (el, delay) {
            setTimeout(function () { el.classList.add('is-visible'); }, delay);
          })(card, t);
          t += CARD_STAGGER;
        });
        t += (ANIM_DURATION - CARD_STAGGER);
      });
    }

    var triggered = false;
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting && !triggered) {
          triggered = true;
          runSequence();
          io.disconnect();
        }
      });
    }, { threshold: 0.15 });
    io.observe(root);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
